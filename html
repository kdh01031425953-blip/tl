<style>
:root{--bg:#0b1220;--fg:#e8eefc;--card:#141d33;--mut:#9fb0d0;--sea:#3aa0ff;--land:#7bc043;--ac:#ffb347;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:light){:root:not([data-theme=dark]){--bg:#f4f7fc;--fg:#10203a;--card:#fff;--mut:#51628a}}
:root[data-theme=dark]{--bg:#0b1220;--fg:#e8eefc;--card:#141d33;--mut:#9fb0d0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,"Apple SD Gothic Neo","Malgun Gothic",sans-serif}
header{text-align:center;padding:28px 16px 8px}h1{margin:0;font-size:clamp(24px,6vw,40px)}
.stats{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:14px 0}
.stats div{background:var(--card);border-radius:14px;padding:8px 16px;font-size:13px;color:var(--mut)}.stats b{display:block;font-size:26px;color:var(--ac)}
nav{display:flex;gap:8px;justify-content:center;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);padding:8px;z-index:5}
nav button,.rp,.sb{border:0;border-radius:20px;padding:8px 18px;background:var(--card);color:var(--fg);font:inherit;cursor:pointer}
nav button.a,.sb.a{background:var(--ac);color:#111;font-weight:700}
.rp{font-size:12px;padding:3px 10px;float:right}
main{max-width:900px;margin:auto;padding:0 12px 30px}.tab{display:none}.tab.a{display:block}
.card{background:var(--card);border-radius:18px;padding:14px;margin:14px 0}
h2{margin:0 0 6px;font-size:18px}.card p{margin:4px 0;color:var(--mut);font-size:14px}
svg{width:100%;height:auto;display:block}svg text{fill:var(--fg);font-size:11px}
.row{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
[data-name],[data-info]{cursor:pointer}
#tip{position:fixed;pointer-events:none;background:#000c;color:#fff;padding:3px 9px;border-radius:8px;font-size:13px;display:none;z-index:20}
#pop{position:fixed;left:10px;right:10px;bottom:10px;max-width:520px;margin:auto;background:var(--ac);color:#111;padding:12px 16px;border-radius:14px;display:none;z-index:20;font-size:14px}
.sea{border-left:5px solid var(--sea)}.land{border-left:5px solid var(--land)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.an{background:var(--card);border-radius:16px;padding:10px;cursor:pointer;transition:.3s}.an .d{display:none;font-size:14px;color:var(--mut)}
.an.open{grid-column:1/-1;transform:scale(1.01);box-shadow:0 0 0 2px var(--ac)}.an.open .d{display:block}.an svg{max-height:90px}.an.open svg{max-height:150px}
.tag{font-size:11px;border-radius:10px;padding:1px 8px;color:#111}.tag.s{background:var(--sea)}.tag.l{background:var(--land)}
.cond{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px}.cond div{background:#ffffff12;border-radius:12px;padding:8px;font-size:13px}.cond b{color:var(--ac)}
footer{text-align:center;font-size:12px;color:var(--mut);padding:20px 14px}footer a{color:var(--ac)}
/* animations */
.dr{stroke-dasharray:1;stroke-dashoffset:1}.on .dr{stroke-dashoffset:0;transition:stroke-dashoffset 3.5s ease}
.v .arc{stroke-dasharray:0 100;transition:stroke-dasharray 3s}.on .arc{stroke-dasharray:88.2 100}
.hand{transform-origin:100px 100px;transform:rotate(0);transition:transform 3s}.on .hand{transform:rotate(317.5deg)}
.prog{transform-origin:20px 0;transform:scaleX(0);transition:transform 5s linear}.on .prog{transform:scaleX(1)}
.ob{transform-origin:bottom;transform-box:fill-box;transform:scaleY(.03)}.on .ob{animation:ox 5s forwards}
@keyframes ox{0%{transform:scaleY(.03)}45%{transform:scaleY(.06)}60%{transform:scaleY(.3)}100%{transform:scaleY(1)}}
.on .tg{animation:fl 5s forwards}.tg{opacity:0}@keyframes fl{0%,40%{opacity:0}55%,100%{opacity:1}}
.b{animation:rise 3s infinite}@keyframes rise{from{transform:translateY(0);opacity:1}to{transform:translateY(-70px);opacity:0}}
#oc[data-s="1"] .w{fill:#2e8f8a}#oc[data-s="2"] .w{fill:#2a7bd0}#oc[data-s="3"] .w{fill:#8fd0f0}
.w{transition:.8s}#oc[data-s="3"] .wl{transform:translateY(22px)}.wl{transition:.8s}
.fe{transition:.8s}#oc[data-s="2"] .fe{opacity:.35}#oc[data-s="3"] .fe{opacity:.1}
.ox{opacity:0;transition:.8s}#oc[data-s="2"] .ox,#oc[data-s="3"] .ox{opacity:1}
.ice{opacity:0;transition:.8s}#oc[data-s="3"] .ice{opacity:1}
.th{transition:.8s;transform-box:fill-box;transform-origin:bottom}#oc[data-s="1"] .th{transform:scaleY(.9)}#oc[data-s="2"] .th{transform:scaleY(.55)}#oc[data-s="3"] .th{transform:scaleY(.2)}
.k{animation:drift 14s ease-in-out infinite}.k2{animation-name:d2}.k3{animation-name:d3}.k4{animation-name:d4}
@keyframes drift{0%,100%{transform:translate(-70px,-45px)}45%,55%{transform:none}}
@keyframes d2{0%,100%{transform:translate(70px,-45px)}45%,55%{transform:none}}
@keyframes d3{0%,100%{transform:translate(-70px,45px)}45%,55%{transform:none}}
@keyframes d4{0%,100%{transform:translate(70px,45px)}45%,55%{transform:none}}
.rod{animation:rl 14s infinite}@keyframes rl{0%,35%,65%,100%{opacity:0}45%,55%{opacity:1}}
.lv{animation:lava 1.6s infinite}.lv:nth-child(2){animation-delay:.5s}.lv:nth-child(3){animation-delay:1s}
@keyframes lava{from{transform:translate(0,0);opacity:1}to{transform:translate(var(--x,10px),-60px);opacity:0}}
.sw{animation:sw 4s ease-in-out infinite}@keyframes sw{50%{transform:translateX(8px)}}
.pl{animation:pu 2s infinite}@keyframes pu{50%{opacity:.4}}
</style></head><body>
